# Kopieren nach clubs/fussball/.env und Passwörter ersetzen (.env wird NICHT ins Git eingecheckt).
CLUB=fussball
# Projektname = Präfix der Container (tresen-fussball-db, tresen-fussball-web, tresen-fussball-db-backup)
COMPOSE_PROJECT_NAME=tresen-fussball
# Port auf dem Unraid-Host, unter dem diese Instanz erreichbar ist (pro Verein eindeutig!)
WEB_PORT=8091
# Datenordner dieser Instanz: db/ (Datenbank) und backups/ (Dumps)
DATA_DIR=/mnt/user/appdata/tresen-fussball

MYSQL_ROOT_PASSWORD=BITTE_AENDERN
MYSQL_DATABASE=tresen_fussball
MYSQL_USER=tresen
MYSQL_PASSWORD=BITTE_AENDERN

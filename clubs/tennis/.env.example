# Kopieren nach clubs/tennis/.env und Passwörter ersetzen (.env wird NICHT ins Git eingecheckt).
CLUB=tennis
# Projektname = Präfix der Container (tresen-db, tresen-web, tresen-db-backup)
COMPOSE_PROJECT_NAME=tresen
# Port auf dem Unraid-Host, unter dem diese Instanz erreichbar ist (pro Verein eindeutig!)
WEB_PORT=8090
# Datenordner dieser Instanz: db/ (Datenbank) und backups/ (Dumps)
DATA_DIR=/mnt/user/appdata/strichliste

MYSQL_ROOT_PASSWORD=BITTE_AENDERN
MYSQL_DATABASE=tresen
MYSQL_USER=tresen
MYSQL_PASSWORD=BITTE_AENDERN
